# ---- AI ----
ANTHROPIC_API_KEY=sk-ant-...
# 省略時 claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max（省略時 medium）
CLAUDE_EFFORT=medium
# SYSTEM_PROMPT=あなたは社内ヘルプデスクのアシスタントです。
# API を呼ばずに配線だけ確認したいとき
# RUNNER=echo

# ---- Slack（Socket Mode）----
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# ---- アダプタ選択 ----
# slack / http / slack,http（省略時: SLACK_BOT_TOKEN があれば slack、なければ http）
# ADAPTERS=slack

# ---- HTTP アダプタ ----
# PORT=3000
# HOST=127.0.0.1
# OUTBOUND_WEBHOOK=https://example.com/hook   # AI の返信を転送したい先（任意）

# ---- 保存先 ----
# DATA_DIR=data/conversations
