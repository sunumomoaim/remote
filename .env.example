# ---- 回答エンジン ----
# 既定は claude-code（PC の Claude Code を使う。Pro/Max の契約枠で動き、追加料金なし）
# RUNNER=claude-code
# claude コマンドが PATH にないときだけ
# CLAUDE_COMMAND=/usr/local/bin/claude
# モデルを指定したいとき（claude-code 方式: sonnet / opus など、api 方式: claude-opus-5-5 など）
# CLAUDE_MODEL=sonnet
# SYSTEM_PROMPT=あなたは社内ヘルプデスクのアシスタントです。

# API 従量課金で動かす場合だけ（設定すると自動で RUNNER=api になる）
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_EFFORT=medium

# 配線だけ確認したいとき
# RUNNER=echo

# ---- Slack（Socket Mode）----
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# 回答の先頭に「@発言者 > 元の発言」を付ける（既定 true）
# SLACK_QUOTE_ORIGINAL=true
# スレッド返信をチャンネルにも表示する（既定 false）
# SLACK_REPLY_BROADCAST=false

# ---- アダプタ選択 ----
# slack / http / slack,http（省略時: SLACK_BOT_TOKEN があれば slack、なければ http）
# ADAPTERS=slack

# ---- HTTP アダプタ ----
# PORT=3000
# HOST=127.0.0.1
# OUTBOUND_WEBHOOK=https://example.com/hook   # AI の返信を転送したい先（任意）

# ---- 保存先 ----
# DATA_DIR=data/conversations
